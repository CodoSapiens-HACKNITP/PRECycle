{
  "name": "precycle",
  "version": "1.0.0",
  "description": "Site for recyclable waste management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client && npm install"
  },
  "author": "CodoSapiens",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "config": "^3.3.11",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-validator": "^7.0.1",
    "gravatar": "^1.8.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.0.0",
    "prettier": "^3.0.0",
    "react-datepicker": "^4.25.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.26.0",
    "redux": "^5.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "redux-thunk": "^3.1.0",
    "request": "^2.88.2",
    "sass": "^1.69.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0"
  }
}
